# Copy to application-local.properties (gitignored) or set environment variables.
# See: https://docs.spring.io/spring-boot/docs/current/reference/html/features.html#features.external-config

spring.application.name=skillbridge
server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3306/skillbridge_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD

jwt.secret=YOUR_256_BIT_OR_LONGER_JWT_SECRET_KEY_HERE
jwt.expiration=86400000

gemini.api.key=YOUR_GEMINI_API_KEY
gemini.api.url=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

app.seed-data=true
